{
  "name": "gate-of-all-beings",
  "private": true,
  "workspaces": [
    "server/app/src/world-map",
    "packages/shared-ui",
    "packages/shared-types",
    "packages/shared-data",
    "packages/shared-session"
  ],
  "scripts": {
    "data:world": "python packages/shared-data/export_worldview.py",
    "data:cards": "node --import ./server/app/src/cards/node_modules/tsx/dist/loader.mjs packages/shared-data/export_cards.mjs",
    "verify:game-data": "node packages/shared-session/verify-game.mjs",
    "verify:game-ui": "node packages/shared-session/verify-game-ui.mjs",
    "prepare:gallery-engine": "npm ci --prefix portal/www/gallery-engine",
    "build:homepage": "npm run prepare:gallery-engine && node portal/www/scripts/build-homepage.mjs",
    "build:release": "npm run build:modules && npm run build:homepage",
    "release:seal": "node scripts/publish-release.mjs all",
    "release:rollback": "node scripts/publish-release.mjs rollback",
    "dev:homepage": "node portal/www/scripts/build-homepage.mjs --dev",
    "build:cards": "node scripts/build-cards.mjs",
    "build:world-map": "node scripts/build-world-map.mjs",
    "check:world-map": "npm run check --workspace=@iridescently/world-map",
    "build:modules": "node server/app/scripts/build-modules.mjs",
    "test:portal": "python server/verify_portal.py",
    "assets:manifest": "node scripts/assets-manifest.mjs",
    "update:status": "node scripts/update.mjs status",
    "update:check": "node scripts/update.mjs check",
    "update:code": "node scripts/update.mjs code",
    "update:assets": "node scripts/update.mjs assets",
    "update": "node scripts/update.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:huiguan-image-upload": "node portal/huiguan/tests/image-upload-contract.cjs",
    "test:huiguan-auth-next": "node portal/huiguan/tests/auth-next.cjs",
    "test:oauth-mock": "node portal/huiguan/tests/oauth-e2e.cjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
