{
  "name": "gate-of-all-beings",
  "private": true,
  "workspaces": [
    "server/app/src/world-map",
    "shared/shared-ui",
    "shared/shared-types",
    "shared/shared-data",
    "shared/shared-session"
  ],
  "scripts": {
    "data:world": "python shared/shared-data/export_worldview.py",
    "data:cards": "node --import ./server/app/src/cards/node_modules/tsx/dist/loader.mjs shared/shared-data/export_cards.mjs",
    "verify:game-data": "node shared/shared-session/verify-game.mjs",
    "verify:game-ui": "node shared/shared-session/verify-game-ui.mjs",
    "build:homepage": "node portal/www/scripts/build-homepage.mjs",
    "dev:homepage": "node portal/www/scripts/build-homepage.mjs --dev",
    "build:cards": "node ops/build-cards.mjs",
    "build:world-map": "node ops/build-world-map.mjs",
    "check:world-map": "npm run check --workspace=@iridescently/world-map",
    "publish:cards": "node ops/publish-release.mjs cards",
    "publish:world-map": "node ops/publish-release.mjs world-map",
    "build:modules": "node server/app/scripts/build-modules.mjs",
    "publish:homepage": "node ops/publish-release.mjs homepage",
    "publish:modules": "node ops/publish-release.mjs modules",
    "test:portal": "python server/verify_portal.py",
    "test:huiguan-image-upload": "node portal/huiguan/tests/image-upload-contract.cjs",
    "test:huiguan-form-ui": "node portal/huiguan/tests/form-ui-contract.cjs",
    "assets:manifest": "node ops/assets-manifest.mjs",
    "update:status": "node ops/update.mjs status",
    "update:check": "node ops/update.mjs check",
    "update:code": "node ops/update.mjs code",
    "update:assets": "node ops/update.mjs assets",
    "update": "node ops/update.mjs",
    "build:site": "node ops/build-site.mjs",
    "publish:site": "node ops/publish-release.mjs site"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
