    "min_tier": "C",
    "or_collect_per_element": 3,
    "gap": "（R2 遗留 · 已解除）原判「土系主属性 7 名角色最高仅 D 档，静态不满足 min_tier=C」；R7 核查证实该结论源于派生规则缺陷（并列系写法漏匹配 + 高位身份未识别 + 主属性排序抢先），非世界观事实。修正并全量重跑后土系主属性 7 名（不变；systems 含土系者 11 名）、其中 C 档以上 1 名（池年 id=61 · E → C · 化神），成就静态可达成。",
    "reference_tool": "integration/tools/decide_ach_system_001.py",
    "resolution": {
      "plan": "A · 数据侧补齐土系 C 档",
      "how": "修正 data/stat-model.json v1.1.0 的 element.segmentMatch（并列系切段精确认系）与 realm.identityRules（高位身份补正境界）后全量重跑，非人工拔高数值；池年 E → C、境界 金丹 → 化神",
      "engine_change": false,
      "landed_in": "R7",
      "verified_by": "data/scripts/audit_r2.py + integration/verify/verify_integration.py"
    },
    "fallback": {
      "plan": "C · 替代路径 or_collect_per_element",
      "value": 3,
      "status": "not-needed",
      "how": "某系无 C 档角色时，收集该系 3 名亦可点亮（需引擎将 min_tier 与替代分支参数化）。R7 土系已有 C 档，本路径不启用，仅保留定义以待后续新系别扩展",
      "engine_change": true
    },
    "rejected": {
      "plan": "B · 放宽 min_tier C -> D",
      "reason": "语义降档会使后续所有系别成就一并贬值"
    },
    "note": "ach_system_001 的 condition 语义（min_tier=C）保持不变，本轮由数值侧修正达成；引擎侧 C_TIER_OR_ABOVE = ['C','B','A'] 与 min_tier 一致，无需参数化改造。"
  }
