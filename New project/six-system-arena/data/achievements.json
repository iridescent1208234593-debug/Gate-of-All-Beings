  "description": "收集类成就全量定义。核心定位：让玩家为了『集齐』而反复对战。失败不惩罚；成就判定只读战斗日志 + 数值产物，不做随机掉率判定。",
  "design_principles": [
    "失败不惩罚：败局不扣资源、不掉收集进度，且不触发成就判定。",
    "收集优先于数值：奖励以图鉴位 / 立绘 / 称号 / 徽章为主，数值加成为辅。",
    "可验证：达成条件全部基于战斗日志契约字段或 character_stats 的确定性字段。",
    "忠于原作：角色称谓、阵营、羁绊文案取自世界观数据库，不自行发明设定。"
  ],
  "battle_log_contract": {
    "note": "由经营 / 模拟子系统写入的统一战斗日志；本子系统只定义字段契约，不落盘。",
    "fields": {
      "battle_id": "string · 对局唯一标识",
      "mode": "string · story | arena | challenge | mirror",
      "my_character_id": "int · 我方主将 character_id",
      "opponent_id": "int|null · 对手 character_id（镜像战为自身 id）",
      "opponent_type": "string · official | mirror",
      "result": "string · win | lose",
      "turn_used": "int · 实际消耗回合数",
      "hp_left": "int · 我方结算剩余血量",
      "hp_max": "int · 我方主将血量上限（用于零损血判定）",
      "seed": "int · 随机种子（可复现）"
    },
    "required": [
      "battle_id",
      "mode",
      "my_character_id",
      "opponent_id",
      "opponent_type",
      "result",
      "turn_used",
      "hp_left",
      "seed"
    ]
  },
  "metrics": {
    "note": "progress.metric 指向本表；achievement-system.js 逐项计算当前值，与 progress.target 比较。",
