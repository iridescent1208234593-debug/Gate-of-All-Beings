# 请从 Linux 文件系统中的仓库根目录运行；不要与 Windows 共用 node_modules。
SHELL := /bin/bash
# 所有本地环境和运行数据默认放在用户目录。
LOCAL_DEV ?= $(HOME)/.local/share/iridescently-local-dev
PYTHON_BOOTSTRAP ?= python3.12
VENV := $(LOCAL_DEV)/python-venv
NODE_HOME ?= $(LOCAL_DEV)/node/bin
export PATH := $(NODE_HOME):$(VENV)/bin:$(PATH)
override export IRIDESCENTLY_ENVIRONMENT := development
override export IRIDESCENTLY_STORAGE_ROOT := $(LOCAL_DEV)/runtime
override export PYTHON := $(VENV)/bin/python
export GALLERY_DIR ?= $(LOCAL_DEV)/gallery-placeholder
unexport IRIDESCENTLY_DATA_ROOT IRIDESCENTLY_ASSETS_ROOT IRIDESCENTLY_CACHE_ROOT IRIDESCENTLY_RELEASE_ROOT IRIDESCENTLY_BACKUP_ROOT IRIDESCENTLY_PROJECT_ROOT IRIDESCENTLY_WORKSPACE_ROOT

# 默认显示帮助；各目标名称不是实际文件。
.PHONY: help doctor setup build seal start status smoke stop
.DEFAULT_GOAL := help

# 将 start 后的数字作为端口；拒绝其他附加参数。
ifneq ($(filter start,$(MAKECMDGOALS)),)
ifneq ($(word 2,$(MAKECMDGOALS)),)
START_PORT := $(word 2,$(MAKECMDGOALS))
ifneq ($(strip $(subst 9,,$(subst 8,,$(subst 7,,$(subst 6,,$(subst 5,,$(subst 4,,$(subst 3,,$(subst 2,,$(subst 1,,$(subst 0,,$(START_PORT)))))))))))),)
$(error 端口必须是数字)
endif
ifneq ($(word 3,$(MAKECMDGOALS)),)
$(error start 最多接收一个端口)
endif
$(START_PORT):
	@:
endif
endif

help:
	@echo '在仓库根目录执行：make 目标'
	@echo '也可执行：make -f makefile-auto/Makefile.ubuntu 目标'
	@echo '  help    显示帮助'
	@echo '  doctor  检查所需工具和版本'
	@echo '  setup   准备虚拟环境、依赖和本地示例数据'
	@echo '  build   构建本地发布候选'
	@echo '  seal    封存本地发布版本'
	@echo '  start   启动本地服务'
	@echo '  status  查看本地服务状态'
	@echo '  smoke   执行本地冒烟检查'
	@echo '  stop    停止本地服务'
	@echo '使用顺序：doctor -> setup -> build -> seal -> start -> status -> smoke'
	@echo '使用结束后：stop'
	@echo '自定义入口端口：make start 18080（默认 8080）'

# 检查工具及版本，不安装系统软件。
doctor:
	@echo '=== 检查 Node 22、FFmpeg、Git 和 Python 3.12 ==='
	@node -e "if(!process.versions.node.startsWith('22.')){console.error('需要 Node 22');process.exit(1)};console.log('Node',process.versions.node)"
	@command -v ffmpeg >/dev/null || { echo '缺少 FFmpeg'; exit 1; }
	@git --version
	@$(PYTHON_BOOTSTRAP) -c "import sys;print('Python',sys.version.split()[0]);sys.exit(sys.version_info[:2] != (3,12))"
	@if [ -x "$(PYTHON)" ]; then "$(PYTHON)" -c "import sys;print('venv',sys.version.split()[0]);sys.exit(sys.version_info[:2] != (3,12))"; else echo 'venv 尚未创建'; fi
	@if [ ! -x "$(PYTHON)" ]; then $(PYTHON_BOOTSTRAP) -c "import ensurepip" 2>/dev/null || { echo '缺少 Python 3.12 venv 支持，请安装 python3.12-venv'; exit 1; }; fi

# 初始化独立环境；已有目录、密钥和示例数据不覆盖。
setup: doctor
	@case "$(CURDIR)" in /mnt/[a-zA-Z]/*) echo '请在 Linux 文件系统的独立检出中运行，避免共用 Windows node_modules'; exit 1;; esac
	@if [ -e "$(VENV)" ] && [ ! -x "$(PYTHON)" ]; then echo '已有 venv 目录但缺少 Python，拒绝覆盖'; exit 1; fi
	@if [ ! -x "$(PYTHON)" ]; then $(PYTHON_BOOTSTRAP) -m venv "$(VENV)"; fi
	@"$(PYTHON)" -m pip install Pillow==12.3.0
	@if [ ! -d node_modules ]; then npm ci; else echo '保留已有根 node_modules；需要更新时请自行运行 npm ci'; fi
	@for module in cards management ecology softie; do if [ ! -d "apps/$$module/node_modules" ]; then npm ci --prefix "apps/$$module" || exit $$?; else echo "保留已有 apps/$$module/node_modules"; fi; done
	@if [ ! -d apps/www/gallery-engine/node_modules ]; then npm ci --prefix apps/www/gallery-engine; else echo '保留已有 gallery-engine/node_modules'; fi
	@"$(PYTHON)" -c "import sys;sys.path.insert(0,'services/platform');import storage_paths as s;p=s.data_root();m=p/s.MARKER;s.require_ready() if m.exists() else (s.initialize_storage() if not p.exists() or not any(p.iterdir()) else sys.exit('已有数据但没有就绪标记，已拒绝初始化'));print('development 存储就绪')"
	@"$(PYTHON)" -c "from pathlib import Path;import secrets;p=Path(r'$(IRIDESCENTLY_STORAGE_ROOT)')/'development/data/secrets/server.env';p.exists() or p.write_text('HX_SSO_SECRET='+secrets.token_urlsafe(48)+'\n',encoding='utf-8');print('本地密钥配置就绪')"
	@"$(PYTHON)" -c "from pathlib import Path;import base64;p=Path(r'$(LOCAL_DEV)')/'gallery-placeholder';p.mkdir(parents=True,exist_ok=True);f=p/'onboarding-placeholder.png';f.exists() or f.write_bytes(base64.b64decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII='));print('画廊占位目录就绪')"
	@if [ ! -e "$(IRIDESCENTLY_STORAGE_ROOT)/development/data/worldview/worldview_luoxiaohei_v4.db" ]; then "$(PYTHON)" -c "import sqlite3;from pathlib import Path;p=Path(r'$(IRIDESCENTLY_STORAGE_ROOT)')/'development/data/worldview/worldview_luoxiaohei_v4.db';p.open('xb').close();c=sqlite3.connect(p);c.executescript('CREATE TABLE characters (id INTEGER PRIMARY KEY,name TEXT,aliases TEXT,category TEXT,merged_to TEXT,completeness INTEGER,type TEXT,thumb_path TEXT,avatar_id INTEGER);CREATE TABLE character_images (id INTEGER PRIMARY KEY,character_id INTEGER,image_path TEXT,image_type TEXT,description TEXT,sort_order INTEGER);CREATE VIEW v_character_gallery AS SELECT * FROM characters;');c.execute('INSERT INTO characters(id,name,category,completeness,type) VALUES(1,?,?,8,?)',('LOCAL TEST CHARACTER','TEST','TEST'));c.commit();c.close();print('已创建仅供测试的世界观示例库')"; fi
	@echo '初始化完成。世界观示例库和画廊占位图不是真实数据。'

# 从已提交源码构建候选；此操作会重建候选目录。
build:
	@npm run build:site
	@npm run build:release

# 封存候选到本地 development 发布通道。
seal:
	@npm run release:seal

# 管理本地服务并执行冒烟验证。
start:
	@"$(PYTHON)" tools/runtime/local-runtime.py start $(if $(START_PORT),--port $(START_PORT),)
	@echo '本地服务已启动，或已处于正常运行状态。'

status:
	@"$(PYTHON)" tools/runtime/local-runtime.py status
	@echo '本地服务状态查询完成；请查看上方运行和健康状态。'

smoke:
	@"$(PYTHON)" tools/checks/local-smoke.py --runtime-state "$(IRIDESCENTLY_STORAGE_ROOT)/development/cache/runtime/local-runtime.json"
	@echo '本地冒烟检查通过。'

stop:
	@"$(PYTHON)" tools/runtime/local-runtime.py stop >/dev/null
	@echo '本地托管服务已全部停止（如果之前没有运行，也会显示此提示）。'
