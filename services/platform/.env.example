# Shared SSO signing key. Copy to server/.env.local (Git ignored).
# A process-level HX_SSO_SECRET takes precedence. Use the same key for all sites.
HX_SSO_SECRET=replace-with-a-random-private-key

# Huiguan verified-email sender (use a mailbox-specific SMTP authorization code).
# 复制到 server/.env.local（Git 忽略）并填写真实值；环境变量同名项优先。
# 用户端收件邮箱不限（阿里/QQ/Foxmail/Outlook/Gmail 均可）；发信请用专用账号。
# SMTP 凭据必须使用邮箱客户端授权码，不要复用网页登录密码。
# 注意：发信域名若与站点域名不同（如站点 huiguan.iridescently.xyz、发信用阿里邮箱），
# 需为发信域配置 SPF，否则验证邮件易进垃圾箱。
ACCOUNT_EMAIL_SMTP_HOST=smtpdm.aliyun.com
ACCOUNT_EMAIL_SMTP_PORT=465
ACCOUNT_EMAIL_SMTP_USER=account@example.com
ACCOUNT_EMAIL_SMTP_PASSWORD=replace-with-mailbox-smtp-authorization-code
ACCOUNT_EMAIL_FROM=account@example.com
ACCOUNT_EMAIL_BASE_URL=https://huiguan.iridescently.xyz/account.html

# Cloudflare Turnstile on login/register (huiguan /api/auth, /api/login, /api/register).
# Leave TURNSTILE_SECRET empty to keep it off. The site key is public; the secret stays server-side.
# Local/test: use Cloudflare's test pair 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# (refused when IRIDESCENTLY_ENVIRONMENT=production).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
