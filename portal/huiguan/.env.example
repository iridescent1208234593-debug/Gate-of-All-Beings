# 西木会馆站群 · 环境变量配置
# 复制此文件为 .env 或直接在系统中设置这些环境变量
# Set HX_SSO_SECRET in your local environment before starting the service.

# 跨站 SSO 签名密钥（hx_sso.py 使用）
HX_SSO_SECRET=replace-with-local-HX_SSO_SECRET

# USSO OAuth 密钥（server_huiguan.py 使用）
USSO_CLIENT_SECRET=replace-with-your-USSO-client-secret

# 众生之门 OAuth 密钥（zszm/server.py 使用）
ZSZM_CLIENT_SECRET=replace-with-your-ZSZM-client-secret