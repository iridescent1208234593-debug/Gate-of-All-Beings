{
  "description": "ZSZM and required dependencies: HTTP to HTTPS",
  "expression": "(http.host in {\"zszm.iridescently.xyz\" \"iridescently.xyz\" \"huiguan.iridescently.xyz\" \"oc.iridescently.xyz\"} and http.request.scheme eq \"http\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 308,
      "target_url": {
        "expression": "concat(\"https://\", http.host, http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
