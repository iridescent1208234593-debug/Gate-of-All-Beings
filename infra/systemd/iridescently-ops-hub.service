# B only. Unified read-only ops API on 127.0.0.1:18420.
[Unit]
Description=Iridescently ops hub (B)
After=iridescently-ops-visitor.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=iridescently-ops
Group=iridescently-ops
WorkingDirectory=/opt/iridescently-ops/services/ops
ExecStart=/usr/bin/python3 -B -m opsnode.hub --config /etc/iridescently-ops/hub.json
Restart=on-failure
RestartSec=2
RestartSteps=4
RestartMaxDelaySec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=iridescently-ops/hub
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
