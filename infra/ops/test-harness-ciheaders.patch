+class CIHeaders(dict):
+    """Case-insensitive response headers.
+
+    HTTP/2 (and Cloudflare in front of it) lower-cases header names, so a plain
+    dict(response.getheaders()).get("Location") silently returns None and the
+    redirect checks report a false "missing Location".
+    """
+
+    def __init__(self, items):
+        super().__init__()
+        for key, value in items:
+            self[key.lower()] = value
+
+    def get(self, key, default=None):
+        return super().get(key.lower(), default)
+
+    def __getitem__(self, key):
+        return super().__getitem__(key.lower())
+
+    def __contains__(self, key):
+        return super().__contains__(key.lower())
+
+
